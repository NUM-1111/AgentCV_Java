{
  "api": {
    "timeout": 180000,
    "maxRetries": 2,
    "retryDelay": 5000,
    "requestRateLimit": 10,
    "requestRateWindowMs": 60000
  },
  "terminal": {
    "timeout": 180000,
    "maxBufferSize": 5242880,
    "killOnTimeout": true,
    "persistSession": false,
    "commandDelay": 1000,
    "shell": "/bin/bash",
    "shellArgs": ["--norc", "--noprofile"]
  },
  "agent": {
    "maxConsecutiveToolCalls": 8,
    "maxThinkingTimeMs": 180000,
    "maxTotalTimeMs": 600000,
    "pauseOnRepeatedPattern": false,
    "repeatedPatternThreshold": 5,
    "cooldownPeriodMs": 10000
  },
  "context": {
    "maxTokens": 800000,
    "warningThreshold": 0.75,
    "criticalThreshold": 0.9,
    "autoTruncate": true,
    "autoTruncateStrategy": "summary"
  },
  "system": {
    "logLevel": "warn",
    "traceApiCalls": false,
    "traceTerminalCommands": false,
    "healthCheckIntervalMs": 15000,
    "autoRecoverStuckSessions": true,
    "stuckSessionThresholdMs": 120000
  }
}